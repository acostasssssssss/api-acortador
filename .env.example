# App
APP_NAME=LinkForge
APP_VERSION=1.0.0
DEBUG=true
BASE_URL=http://localhost:8000  en caso de querer una fija usar esta variable, de lo contrario dejar comentada para detección automática del dominio

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/urlshortener

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=change-me-in-production-please-use-a-random-string

# Slug Config
DEFAULT_SLUG_LENGTH=6
MAX_SLUG_LENGTH=64
MIN_SLUG_LENGTH=3

# Rate Limiting
RATE_LIMIT_SHORTEN=10/minute
RATE_LIMIT_REDIRECT=100/minute

# Features
ALLOW_CUSTOM_SLUGS=true
TRACK_ANALYTICS=true
SLUG_RESERVATION_DAYS=30
